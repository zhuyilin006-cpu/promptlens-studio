# Vidu S1 实时数字人接入配置
# 复制为 .env.local 并填入真实值。切勿提交 .env.local。

# 工作台获取的 API Key，形如 vda_xxx（仅服务端使用，前端不可见）
VIDU_API_KEY=vda_xxxxxxxxxxxxxxxx

# 国内环境：api.vidu.cn ；海外环境：api.vidu.com （不含协议）
VIDU_HTTP_HOST=api.vidu.cn
VIDU_WS_HOST=api.vidu.cn

# 可选：AliRTC Web SDK 的 CDN 地址（不填则使用内置默认）
# NEXT_PUBLIC_ALIRTC_SDK_URL=

# 置为 1 可强制启用 Mock 模式（无需真实密钥即可演示移动端全流程）
NEXT_PUBLIC_VIDU_MOCK=0
